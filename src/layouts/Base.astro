---
import { site, nav } from "../../site.config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;

// Normalise "/blog/my-post/" → "/blog" so the tab stays lit on post pages.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✦</text></svg>"
    />
    <script is:inline>
      // Runs before paint — no flash of the wrong theme.
      const t = localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    </script>
  </head>

  <body>
    <div class="site">
      <header class="masthead">
        <div class="wrap">
          <div class="masthead-row">
            <a class="brand" href="/">{site.title}</a>
            <button
              class="theme-toggle"
              type="button"
              id="theme-toggle"
              aria-label="Toggle colour theme">◐</button
            >
          </div>
          <nav class="nav" aria-label="Sections">
            {
              nav.map((tab) => (
                <a
                  href={tab.href}
                  aria-current={isCurrent(tab.href) ? "page" : undefined}
                >
                  {tab.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main>
        <div class="wrap">
          <slot />
        </div>
      </main>

      <footer class="footer">
        <div
          class="wrap"
          style="display:flex;flex-wrap:wrap;gap:.5rem 1.1rem;justify-content:space-between;width:100%"
        >
          <span>© {new Date().getFullYear()} {site.title}</span>
          <span class="footer-links">
            {
              site.links.map((l) => (
                <a
                  href={l.href}
                  rel={l.href.startsWith("http") ? "me noopener" : undefined}
                >
                  {l.label}
                </a>
              ))
            }
          </span>
        </div>
      </footer>
    </div>

    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
