---
import { formatDate, isoDate } from "../lib/format";

interface Props {
  posts: any[];
}
const { posts } = Astro.props;
---

<ul class="entries">
  {
    posts.map((post) => (
      <li class="entry">
        <a class="entry-title" href={`/blog/${post.id}/`}>
          {post.data.title}
        </a>
        {post.data.summary && <p class="entry-summary">{post.data.summary}</p>}
        <span class="meta">
          <time datetime={isoDate(post.data.date)}>
            {formatDate(post.data.date)}
          </time>
          {post.data.draft && <span class="tag">draft</span>}
          {post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((t: string) => (
                <span class="tag">{t}</span>
              ))}
            </span>
          )}
        </span>
      </li>
    ))
  }
</ul>
