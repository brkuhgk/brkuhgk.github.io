---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { publish } from "../../lib/format";

const posts = publish(await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Blog" description="Everything I've written.">
  <header class="page-head">
    <h1>Blog</h1>
    <p class="lede">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}, newest first.
    </p>
  </header>

  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="lede">
        Nothing here yet. Add a markdown file to <code>content/posts/</code>.
      </p>
    )
  }
</Base>
